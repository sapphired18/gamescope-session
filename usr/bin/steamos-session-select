#!/bin/bash
set -e

# Get the current logged-in user calling this script
CURRENT_USER="${USER:-$(logname)}"

case "$1" in
    'persistent')
        systemctl --user mask cachyos-gamescope-autologin.service
        pkexec /usr/lib/steamos/steam-set-session plasma.desktop "$CURRENT_USER";;
    'oneshot')
        systemctl --user unmask cachyos-gamescope-autologin.service
        pkexec /usr/lib/steamos/steam-set-session gamescope-session.desktop "$CURRENT_USER";;
    'gamescope')
        # Switches to Gamescope and triggers immediate automated login
        pkexec /usr/lib/steamos/steam-set-session gamescope-session.desktop "$CURRENT_USER"
        qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout;;
    'plasma')
        # Gracefully shut down background Steam, then switch to Plasma with Password lock
        steam -shutdown || true
        sleep 2
        systemctl --user stop gamescope-session.target || true
        
        pkexec /usr/lib/steamos/steam-set-session plasma.desktop "$CURRENT_USER";;
    *)
        [[ -n "$1" ]] && echo -e "Unknown session '$1'\n"
        cat <<EOF
Usage: $(basename "$0") <mode>
Modes: persistent | oneshot | gamescope | plasma
EOF
        exit 1;;
esac

if [[ -e /dev/input/.hidden ]]; then
    echo "Unhide hidden controller devices as needed"
    pkexec mv /dev/input/.hidden/* /dev/input
    pkexec rm -r /dev/input/.hidden
fi